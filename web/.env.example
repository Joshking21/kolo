# Comma-separated list of API domains served by the mock (MSW).
# Domains: auth, groups, wallet, payments, notifications, dev
# Remove a domain as its backend phase is finished. Empty = everything goes to the real API.
VITE_MOCK_DOMAINS=auth,groups,wallet,payments,notifications,dev

# Show the "Under the hood" developer panel (always shown when running `npm run dev`).
VITE_SHOW_DEV_PANEL=true
